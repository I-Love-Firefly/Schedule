{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schedule.justindividual.site/schema/ai-import-v1.json",
  "title": "Offline timetable extraction result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentType", "courses"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentType": { "enum": ["weekly_schedule", "other"] },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "teacher",
          "location",
          "dayOfWeek",
          "startPeriod",
          "endPeriod",
          "startTime",
          "endTime",
          "weeks"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "teacher": { "type": "string", "maxLength": 100 },
          "location": { "type": "string", "maxLength": 100 },
          "dayOfWeek": {
            "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
          },
          "startPeriod": { "type": ["integer", "null"], "minimum": 1, "maximum": 20 },
          "endPeriod": { "type": ["integer", "null"], "minimum": 1, "maximum": 20 },
          "startTime": { "type": "string", "pattern": "^$|^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
          "endTime": { "type": "string", "pattern": "^$|^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
          "weeks": { "type": "string", "maxLength": 100 }
        }
      }
    }
  }
}
